# Copiar este archivo a .env antes de usar docker compose:
#   cp .env.example .env
#
# docker compose lee .env automáticamente para interpolar el compose.
# La aplicación Python no lo lee sola; para usarlo en la shell:
#   set -a; source .env; set +a

# Endpoint de LocalStack desde la máquina host.
AWS_ENDPOINT_URL=http://localhost:4566

# Región y credenciales de prueba. LocalStack no valida credenciales reales.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Puerto publicado por docker compose. Si lo cambiás, actualizá AWS_ENDPOINT_URL.
LOCALSTACK_PORT=4566

# Nivel de depuración de LocalStack: 0 (normal) o 1 (verbose).
LOCALSTACK_DEBUG=0
